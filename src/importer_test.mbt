// importer v1 语义锚（防线内层）：往返 N 等价（P1.5 核心验收锚）、D-9 三形态、
// 剥离/生成双确定性、J4xxx 全负样本、tagged-enum hint、D-2 跨样本归一、
// 生成格式快照（fmt-canonical——fmt-stable 已由 CLI 冒烟手验，PLAN §9）

///|
fn do_import(json : String, stem? : String = "t") -> String raise @src.Diag {
  @src.import_source(json, path="t.json", stem~).content
}

///|
fn expect_import_diag(
  json : String,
  code : String,
  strict? : Bool = false,
) -> Unit {
  let d = try {
    let _ = @src.import_source(json, path="t.json", stem="t", strict~)
    "IMPORT-SUCCEEDED-BUT-DIAGNOSTIC-EXPECTED"
  } catch {
    e =>
      if e is @src.Diag(..) {
        e.render()
      } else {
        abort("unexpected error type")
      }
  }
  let ok = d.contains("[\{code}]")
  if !ok {
    println("MISMATCH: expected [\{code}], got:\n\{d}")
    abort("import diagnostic mismatch")
  }
}

///|
test "import : 全类型样本生成快照（fmt-canonical 锚）" {
  let json =
    #|{
    #|  "port": 8080,
    #|  "host": "localhost",
    #|  "tags": ["a", "b"],
    #|  "meta": { "Content-Type": "text/plain" },
    #|  "big": 9223372036854775807,
    #|  "ratio": 1.5e3
    #|}
  let out = do_import(json, stem="config")
  // #18 fmt 不动点形态：///| 补顶层声明、数组内联单行、Map 无尾逗号
  inspect(
    out,
    content="// @generated by jsonmbt import —— 禁手改（再生成：jsonmbt import t.json）。\n// 源：t.json\n\n///|\npub struct Config {\n  port : Int\n  host : String\n  tags : Array[String]\n  meta : Map[String, String]\n  big : Int64\n  ratio : Double\n}\n\n///|\npub let config : Config = Config::{\n  port: 8080,\n  host: \"localhost\",\n  tags: [\"a\", \"b\"],\n  meta: { \"Content-Type\": \"text/plain\" },\n  big: 9223372036854775807,\n  ratio: 1.5e3,\n}\n",
  )
}

///|
test "import→build 往返 N 等价（P1.5 核心验收锚）" {
  let cases : Array[String] = [
    "{\"a\":1,\"b\":\"x\",\"c\":[1,2],\"x\":1.5}", "{\"items\":[{\"id\":1,\"on\":true},{\"id\":2,\"on\":false}]}", // 同构数组 → Array[Struct]
     "{\"h\":{\"a\":1},\"z\":{\"a\":2}}", // 嵌套同形对象
     "{\"port\":8080,\"meta\":{\"Content-Type\":\"t\"},\"big\":9223372036854775807}",
    "[1, 2, 3]", // 顶层数组
     "42", // 顶层标量
     "{\"deep\":[[{\"x\":1}]]}", // 深嵌套
     "{\"items\":[{\"v\":null},{\"v\":1}]}", // 多样本 null → Option
  ]
  for json in cases {
    // null 字段需非 null 样本聚基型——用带样本变体或跳过 null-only 场景
    let j = json
    let src = do_import(j, stem="t")
    let built = @src.build_source(src, path="t.json.mbt", expected_name="t")
    let n1 = @src.normalize_json_text(built)
    let n2 = @src.normalize_json_text(j)
    inspect(n1, content=n2)
  }
}

///|
test "D-9 三形态 : URL/路径字符串内的 // 与 /* 不误伤" {
  // 字符串里的 // 与 /* 必须原样保留（裸正则必误伤——D-9 立案依据）
  // 行注释/块注释经 \n 拼进同一字符串字面量（MoonBit 字符串不跨行）
  let json = "{ \"url\": \"http://x/y\", \"path\": \"a//b\", \"cmt\": \"x/*y*/z\" } // 行注释\n/* 块注释 */"
  let stripped = @src.strip_jsonc(json)
  inspect(stripped.contains("http://x/y"), content="true")
  inspect(stripped.contains("a//b"), content="true")
  inspect(stripped.contains("x/*y*/z"), content="true")
  // 注释区域替换为等长空格（行列不漂移）且能通过解析
  let out = do_import(stripped)
  inspect(out.contains("\"http://x/y\""), content="true")
}

///|
test "D-9 : 剥离字节确定性（同输入恒同输出）" {
  let json = "{ \"a\": 1 // c\n, \"b\": /* x */ 2 }"
  inspect(@src.strip_jsonc(json), content=@src.strip_jsonc(json))
}

///|
test "import : 生成确定性（同输入两次 import 逐字节一致——无时间/版本戳）" {
  let json = "{\"k\":[{\"n\":3,\"m\":\"s\"},{\"n\":4,\"m\":\"t\"}]}"
  inspect(do_import(json), content=do_import(json))
}

///|
test "J1003 : JSON 重复键拒绝（病态输入不替它选语义）" {
  expect_import_diag("{\"a\":1,\"a\":2}", "J1003")
}

///|
test "J4001 : 孤立空数组阻断（strict 档——默认已 Never 占位，#14-2a）" {
  expect_import_diag("{\"empty\":[]}", "J4001", strict=true)
}

///|
test "D-1 : 空数组同形复用启发（组内非空样本 → 复用元素类型）" {
  let out = do_import("{\"items\":[{\"v\":1}],\"more\":[{\"v\":2},{\"v\":3}]}")
  // 同形（键集 {v}）→ 同 struct：空数组场景由异构键触发……本例两组同签名合并；
  // 真正的启发锚在下一个测试（同名字段跨组）
  inspect(out.contains("Array["), content="true")
}

///|
test "D-1 : 空数组二级启发（同名字段他处非空 → 复用）" {
  let out = do_import("{\"a\":{\"xs\":[1,2]},\"b\":{\"ys\":\"k\",\"xs\":[]}}")
  // b.xs 空数组：b 组内无样本；全文件同名字段 a.xs 非空 Array[Int] → 复用
  inspect(out.contains("xs : Array[Int]"), content="true")
}

///|
test "J4002 : 空对象单独形态（strict 档——默认已 Map[String,Never] 占位，#14-2a）" {
  expect_import_diag("{\"obj\":{}}", "J4002", strict=true)
}

///|
test "J4003 : 全 null 字段（Option 基型无信息）" {
  expect_import_diag("{\"maybe\":null}", "J4003")
}

///|
test "J4010 : 异构数组（元素类型不相容）" {
  expect_import_diag("{\"xs\":[1,\"a\"]}", "J4010")
}

///|
test "J4011 : 异值键对象（Map 逃生门不适用）" {
  expect_import_diag("{ \"X-Foo\": 1, \"X-Bar\": \"s\" }", "J4011")
}

///|
test "J4012 : 字段跨样本类型不相容（同签名组内）" {
  expect_import_diag("{\"items\":[{\"v\":1},{\"v\":\"s\"}]}", "J4012")
}

///|
test "J4020 : 超 Int64 诚实拒绝（D-2）" {
  expect_import_diag("{\"id\":99999999999999999999}", "J4020")
}

///|
test "J4020 : Int64 与 Double 混合拒绝（静默 Double 化 = 精度红线）" {
  expect_import_diag(
    "{\"items\":[{\"v\":9223372036854775807},{\"v\":1.5}]}", "J4020",
  )
}

///|
test "D-2 : 跨样本无损上浮（同字段任一样本超 Int → 全体 Int64）" {
  let out = do_import("{\"items\":[{\"v\":1},{\"v\":9223372036854775807}]}")
  inspect(out.contains("v : Int64"), content="true")
}

///|
test "J4030 : tagged-enum 形态 hint（rc 0 不阻断）" {
  let outcome = @src.import_source(
    "{\"items\":[{\"Ok\":true},{\"Ok\":true}]}",
    path="t.json",
    stem="t",
  )
  inspect(outcome.hints.length() > 0, content="true")
  inspect(outcome.hints[0].render().contains("J4030"), content="true")
  inspect(outcome.content.contains("Map"), content="true") // Ok 大写键 → 逃生门
}

///|
test "null 字段多样本聚基型 → Option[T]" {
  let out = do_import("{\"items\":[{\"v\":null},{\"v\":1}]}")
  inspect(out.contains("v : Int?"), content="true")
}

///|
test "键名逃生门 : 保留字/大写/连字符 → Map（同值类型）" {
  let out = do_import("{ \"type\": 1, \"X\": 2, \"a-b\": 3 }")
  inspect(out.contains("Map[String, Int]"), content="true")
}

///|
test "Option 渲染 : null → None、值 → Some" {
  let out = do_import("{\"items\":[{\"v\":null},{\"v\":7}]}")
  inspect(out.contains("None"), content="true")
  inspect(out.contains("Some(7)"), content="true")
}

///|
test "P1-1 防回归 : 指数源文本三形态生成合法字面量（1e2/1E6/-1e3 补小数点）" {
  for
    case in [
      ("{\"d\":1e2}", "1.0e2"),
      ("{\"d\":1E6}", "1.0E6"),
      ("{\"d\":-1e3}", "-1.0e3"),
    ] {
    let (j, want) = case
    let out = do_import(j)
    // 产物合法（回吃自家校验器）+ 指数补点形态
    let _ = @src.build_source(out, path="t.json.mbt", expected_name="t")
    inspect(out.contains(want), content="true")
  }
}

///|
test "P1-2 防回归 : 控制字符生成合法 U+XXXX 形态转义（三段写，无坏插值）" {
  let out = do_import("{\"s\":\"a\\u0001b\\u0000c\\u001fd\"}")
  inspect(out.contains("a\\u{1}b\\u{0}c\\u{31}d"), content="true")
  let _ = @src.build_source(out, path="t.json.mbt", expected_name="t") // 回吃合法
}

///|
test "P1-3/4 防回归 : 空数组中间态不逃逸（strict 档；默认 = Never 占位，#14-2a）" {
  expect_import_diag("[{\"a\":null},{\"a\":[]}]", "J4001", strict=true) // Array[?]? 泄漏形态
  expect_import_diag("[[]]", "J4001", strict=true) // Array[Array[?]] 形态
  expect_import_diag("{\"x\":{\"deep\":[]}}", "J4001", strict=true) // 嵌套孤立空
}

///|
test "RFC 8259 §7 : 字符串内裸控制字符拒绝" {
  expect_import_diag("{\"s\":\"a\u{1}b\"}", "J1002")
}

///|
test "D-9 : json 严格档裸 RFC 8259——尾逗号/注释/BOM 全拒（P2-6① 迁移）" {
  // --input json（jsonc=false）= 对拍基准路径：任何宽松特性不消解。
  // P2-6① 原锚（尾逗号 → J1002）在此档永久保留——防线拆档非删除
  let d = try {
    let _ = @src.import_source(
      "{\"a\":1,}",
      path="t.json",
      stem="t",
      jsonc=false,
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("[J1002]"), content="true")
  let c = try {
    let _ = @src.import_source(
      "{ // c\n\"a\":1}",
      path="t.json",
      stem="t",
      jsonc=false,
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(c.contains("[J1002]"), content="true")
}

///|
test "D-9 : 尾逗号消解——值等价（#22 默认档 jsonc）" {
  // 消解式：strip_jsonc 是唯一宽松层，尾逗号在 pre-pass 等长空格消解，
  // jsonparse 恒裸 RFC 8259。同值异形（尾逗号有无）产同一产物。
  let with_tc = do_import(
    "{\"a\":1 , \"b\":[1, 2 ,], \"c\":{\"d\":2 ,}, \"e\":[[1,],[2,],],}",
  )
  let without = do_import(
    "{\"a\":1, \"b\":[1, 2], \"c\":{\"d\":2}, \"e\":[[1],[2]]}",
  )
  inspect(with_tc, content=without)
}

///|
test "D-9 : 尾逗号暂存穿透注释（\", // c \\n }\" 形态）" {
  // tsconfig 真实形态：尾逗号后跟行注释再闭括号——pending-comma 的
  // 暂存必须穿透空白**与注释**看有效字符才判定消解
  let with_tc = do_import(
    "{\"a\":1, // note\n \"b\":2, /* blk\n still note */}",
  )
  let without = do_import("{\"a\":1, \"b\":2}")
  inspect(with_tc, content=without)
}

///|
test "D-9 : BOM 文件首消解 + 字符串内 U+FEFF 保留" {
  // BOM 仅消解文件首字符（RFC 8259 字符串内允许任意 Unicode——U+FEFF
  // 是合法字符，全文件替换会破数据）
  let _ = do_import("\u{FEFF}{\"a\":1}") // 不再 J1002 拒
  let bom = do_import("\u{FEFF}{\"a\":1}")
  inspect(bom.contains("a : Int"), content="true")
  let s = do_import("{\"a\":\"\u{FEFF}x\"}")
  inspect(s.contains("\u{FEFF}x"), content="true")
}

///|
test "D-9 : 开头/孤立/值缺失逗号不收（last_sig guard——防 [,] 超收）" {
  expect_import_diag("{,}", "J1002")
  expect_import_diag("[,]", "J1002")
  expect_import_diag("[1,,]", "J1002")
  // `[1,2,,]`：孤立逗号消解与否都被 parser 拒（前逗号顶位），但 last_sig
  // 在 flush 时漏更新会让报错从逗号本位（U+002C）漂到闭合括号（U+005D）
  // ——与「保位」锚配对钉住 guard（埋雷实锤：禁用 guard 保位锚先红）
  expect_import_diag("[1,2,,]", "J1002")
  expect_import_diag("{\"a\":,}", "J1002")
}

///|
test "D-9 : 消解保位——错误行列不漂移（等长空格替换）" {
  // [1, /* c */ ,] 的孤立逗号保留 → parser 在原字符位报错（U+002C @1:13，
  // 等长替换不挪位）——含注释前缀的列位断言即回归锚
  let d = try {
    let _ = do_import("[1, /* c */ ,]")
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("[J1002] t.json:1:13"), content="true")
}

///|
test "P2-6③ : D-1 二级启发元素类型判别（非 Int——弱锚换牙）" {
  // a.xs 非空 Array[String] → b.xs 空数组复用 String（原锚恰好同 Int 值，无判别力）
  let out = do_import("{\"a\":{\"xs\":[\"s\"]},\"b\":{\"ys\":1,\"xs\":[]}}")
  inspect(out.contains("xs : Array[String]"), content="true")
}

///|
test "审 P3 : Int64 下界 -2^63 不误拒（数值边界补齐）" {
  let out = do_import("{\"a\":-9223372036854775808}")
  inspect(out.contains("a : Int64"), content="true")
  let _ = @src.build_source(out, path="t.json.mbt", expected_name="t") // 回吃合法
}

///|
test "Vitro catalog 防回归 : 星面字符（emoji 代理对）不越界 panic" {
  // 根因：String.length()（UTF-16 码元）> to_array()（码点）——n 虚大越界；
  // 62 个 emoji 的真实 catalog 曾触发（fail loud 契约禁 panic）
  let out = do_import("{\"msg\": \"a🔧b📋c\"}")
  inspect(out.contains("a🔧b📋c"), content="true")
  let _ = @src.build_source(out, path="t.json.mbt", expected_name="t") // 回吃合法
}

///|
test "Vitro rules 防回归 : 带点键（\"memory.dump\"）只验首字符的漏网 → Map 逃生门" {
  // is_legal_label 曾只验首字符——"memory.dump" 小写开头放行，点直进产物
  // 产 J1001（审 A4 的 label 通道变体）；修后全字符验证 → 整对象转 Map
  let out = do_import(
    "{\"skip\": { \"capabilities\": \"a\", \"memory.dump\": \"b\" }}",
  )
  inspect(out.contains("{ \"capabilities\""), content="true")
  inspect(out.contains("\"memory.dump\""), content="true")
  let _ = @src.build_source(out, path="t.json.mbt", expected_name="t") // 回吃合法
}

///|
test "化石批量防回归 : 带点 stem 清洗（array_address.c → 合法 binding）" {
  let out = do_import("{\"v\": 1}", stem="array_address.c")
  inspect(out.contains("pub let array_address_c"), content="true")
  let _ = @src.build_source(
    out,
    path="t.json.mbt",
    expected_name="array_address_c",
  )
}

///|
test "sanitize_stem : 空串/数字开头/大写/中文" {
  inspect(@src.sanitize_stem(""), content="x")
  inspect(@src.sanitize_stem("9x"), content="x_9x")
  inspect(@src.sanitize_stem("Config"), content="config")
  inspect(@src.sanitize_stem("配置"), content="配置")
}

///|
test "issue #4 防回归 : 跨文件撞名 stem 前缀（同目录后来者）" {
  let a = do_import("{\"entries\":[{\"code\":1,\"title\":\"a\"}]}", stem="a")
  // taken_names 模拟同目录已存在 a.json.mbt（其 struct 名 A/Code）
  let b = @src.import_source(
    "{\"payloads\":[{\"code\":1,\"title\":\"a\"}]}",
    path="b.json",
    stem="b",
    taken_names=["A", "Code"],
  )
  inspect(a.contains("pub struct Code"), content="true") // 先到者零变化
  inspect(b.content.contains("pub struct BCode"), content="true") // 后来者前缀
  let _ = @src.build_source(b.content, path="b.json.mbt", expected_name="b") // 回吃合法
}

///|
test "审 P2-1 : 保留字 stem 清洗（test.json 等 15/16 实测中招）" {
  inspect(@src.sanitize_stem("test"), content="x_test")
  inspect(@src.sanitize_stem("type"), content="x_type")
  inspect(@src.sanitize_stem("match"), content="x_match")
  inspect(@src.sanitize_stem("view"), content="view") // 非保留字零变化
  // 端到端：保留字文件名 import → 产物合法可回吃
  let out = do_import("{\"k\":1}", stem="test")
  let _ = @src.build_source(out, path="t.json.mbt", expected_name="x_test")
}

///|
test "§8 裁定 : 无参构造器字面量（enum 投影 + 拼错变体 jsonmbt 侧红）" {
  let src =
    #|enum Severity {
    #|  E1001_UnknownChar
    #|  E1002_UnterminatedString
    #|}
    #|struct Entry {
    #|  sev : Severity
    #|}
    #|
    #|pub let entry : Entry = Entry::{
    #|  sev: E1001_UnknownChar,
    #|}
  let out = @src.build_source(src, path="entry.json.mbt", expected_name="entry")
  inspect(out, content="{\"sev\":\"E1001_UnknownChar\"}")
  // 拼错变体：jsonmbt 自持校验写时红（防线补位 moon [4031]）
  let d = try {
    let _ = @src.build_source(
      src.replace(old="E1001_UnknownChar,", new="E1001_UnknownCharX,"),
      path="entry.json.mbt",
      expected_name="entry",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(
    d.contains("enum 'Severity' has no variant 'E1001_UnknownCharX'"),
    content="true",
  )
}

///|
test "§8 裁定 : #| 多行字符串（行净内容 \n 连接 + 类型错位红）" {
  let src =
    #|struct Note {
    #|  body : String
    #|  n : Int
    #|}
    #|
    #|pub let note : Note = Note::{
    #|  body: #|第一行说明
    #|#|第二行说明
    #|,
    #|  n: 1,
    #|}
  let out = @src.build_source(src, path="note.json.mbt", expected_name="note")
  inspect(
    out,
    content="{\"body\":\"第一行说明\\n第二行说明\",\"n\":1}",
  )
  // 类型错位（Int 字段给多行字符串）→ J3004
  let d = try {
    let _ = @src.build_source(
      src.replace(old="n : Int", new="n : Bool"),
      path="note.json.mbt",
      expected_name="note",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("[J3004]"), content="true")
}

///|
test "D-5 转正 : 带 payload 构造器——tag 对象展开（标量/struct 双形态 + 拼错红）" {
  // 标量 payload：E(3032) → {"case":"E","value":3032}
  let scalar =
    #|enum Sev {
    #|  E(Int)
    #|}
    #|struct T {
    #|  s : Sev
    #|}
    #|
    #|pub let t : T = T::{
    #|  s: E(3032),
    #|}
  inspect(
    @src.build_source(scalar, path="t.json.mbt", expected_name="t"),
    content="{\"s\":{\"case\":\"E\",\"value\":3032}}",
  )
  // struct payload：tag + 字段展开进顶层（vm_digest 建模原型）
  let doc =
    #|enum Case {
    #|  Standard(Std)
    #|  CompileFail(Fail)
    #|}
    #|pub struct Std {
    #|  src_sha : String
    #|  exit_code : Int
    #|}
    #|pub struct Fail {
    #|  src_sha : String
    #|  compile_fail : Bool
    #|}
    #|struct Digest {
    #|  cases : Map[String, Case]
    #|}
    #|
    #|pub let digest : Digest = Digest::{
    #|  cases: {
    #|    "a.c": Standard(Std::{ src_sha: "s1", exit_code: 0 }),
    #|    "b.c": CompileFail(Fail::{ src_sha: "s2", compile_fail: true }),
    #|  },
    #|}
  inspect(
    @src.build_source(doc, path="digest.json.mbt", expected_name="digest"),
    content="{\"cases\":{\"a.c\":{\"case\":\"Standard\",\"src_sha\":\"s1\",\"exit_code\":0},\"b.c\":{\"case\":\"CompileFail\",\"src_sha\":\"s2\",\"compile_fail\":true}}}",
  )
  // 拼错 payload 变体 → J3004（自持防线）
  let d = try {
    let _ = @src.build_source(
      scalar.replace(old="E(3032)", new="Y(3032)"),
      path="t.json.mbt",
      expected_name="t",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("no payload variant 'Y'"), content="true")
}

///|
test "D-5 转正边界 : tag 键冲突拒（J3008）+ 无上下文裸构造器拒 + import 不自动转" {
  // payload struct 含 case 字段 → J3008（规格：撞车显式拒，不静默覆盖）
  let coll =
    #|enum C {
    #|  X(P)
    #|}
    #|pub struct P {
    #|  case : String
    #|}
    #|struct T {
    #|  c : C
    #|}
    #|
    #|pub let t : T = T::{
    #|  c: X(P::{ case: "a" }),
    #|}
  let d = try {
    let _ = @src.build_source(coll, path="t.json.mbt", expected_name="t")
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("[J3008]"), content="true")
  // 裸构造器无类型上下文：语义不明保守拒（保持）
  let d2 = try {
    let _ = @src.build_source(
      "pub let t = VerifiedRun",
      path="t.json.mbt",
      expected_name="t",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d2.contains("[J3001]"), content="true")
  // import 不自动转（D-5 规格边界）：缺键异构数组仍拒——拼错字段名与真
  // 可选无法区分 + 自动推断会把数据错误静默类型化（fail loud 纪律）
  let d3 = try {
    let _ = @src.import_source(
      "[{\"a\":1},{\"a\":2,\"b\":3}]",
      path="x.json",
      stem="x",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d3.contains("[J4010]"), content="true")
}

///|
test "import : 保留字字段名改名 where_ + field-alias 注记 + 往返等价（#13）" {
  // 触发条件（issue 实测）：字段名 where（MoonBit 保留字）+ 同层兄弟字段。
  // 现行 = 整对象退 Map 逃生门 → 兄弟值异型统一失败 → 误导性 J4011；
  // 修复后 = struct 照出（where 改名 where_，原始键走 field-alias 注记）
  let json = "{\"a\": [{\"where\": \"x\", \"b\": [\"t\"]}]}"
  let out = do_import(json, stem="w")
  inspect(
    out,
    content="// @generated by jsonmbt import —— 禁手改（再生成：jsonmbt import t.json）。\n// 源：t.json\n// jsonmbt: field-alias Where.where_ = \"where\"\n\n///|\npub struct W {\n  a : Array[Where]\n}\n\n///|\npub struct Where {\n  where_ : String\n  b : Array[String]\n}\n\n///|\npub let w : W = W::{ a: [Where::{ where_: \"x\", b: [\"t\"], }], }\n",
  )
  // 往返：build 侧按注记还原 JSON 键（where_ → where）
  let built = @src.build_source(out, path="w.json.mbt", expected_name="w")
  inspect(built, content="{\"a\":[{\"where\":\"x\",\"b\":[\"t\"]}]}")
}

///|
test "import : 保留字改名与原生尾下划线键共存（撞名两级下划线，#13）" {
  // where → where_，原生 where_ 被顶到 where__——双注记，往返无损
  let json = "{\"where\": 1, \"where_\": 2}"
  let out = do_import(json, stem="w")
  inspect(
    out.contains("where_ : Int") && out.contains("where__ : Int"),
    content="true",
  )
  inspect(
    out.contains("// jsonmbt: field-alias W.where_ = \"where\"") &&
    out.contains("// jsonmbt: field-alias W.where__ = \"where_\""),
    content="true",
  )
  let built = @src.build_source(out, path="w.json.mbt", expected_name="w")
  inspect(built, content="{\"where\":1,\"where_\":2}")
}

///|
test "import : 非可改名非法键的 Map 逃生门失败须点名键因（#13 文案）" {
  // 点号键不可改名（本批范围外）→ 仍走 Map 逃生门；但失败文案必须点名
  // 「键不是合法字段名」这个真因，不得再报误导性的跨样本类型冲突
  let d = try {
    let _ = do_import("{\"a.b\": \"x\", \"c\": [\"t\"]}")
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("[J4011]"), content="true")
  inspect(
    d.contains("'a.b'") && d.contains("not legal MoonBit field labels"),
    content="true",
  )
}

///|
test "import : J4010 键集分布按容器路径分组（#14-3）" {
  // 顶层 doc 与嵌套 schema 是单样本（无漂移），真漂移在 $.entries[]——
  // 报告按容器分组，顶层键集不再与数组元素混计
  let d = try {
    let _ = do_import(
      "{\"doc\": {\"schema\": 1}, \"entries\": [{\"a\": 1, \"b\": 2}, {\"a\": 1, \"c\": 3}]}",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("[J4010]"), content="true")
  inspect(d.contains("at $.entries[]"), content="true")
  inspect(d.contains("2 distinct key sets in 2 samples"), content="true")
  inspect(d.contains("{ doc, entries }"), content="false")
}

///|
test "build : field-alias 注记的解析与校验（J3009 家族，#13）" {
  // 手写文件带注记：build 侧应用逆映射（手写保留字键对象首次可表达）
  let doc =
    #|// jsonmbt: field-alias Rule.where_ = "where"
    #|struct Rule {
    #|  where_ : String
    #|}
    #|
    #|pub let r : Rule = Rule::{
    #|  where_: "x",
    #|}
  inspect(
    @src.build_source(doc, path="r.json.mbt", expected_name="r"),
    content="{\"where\":\"x\"}",
  )
  // 注记指向不存在的 struct → J3009
  let bad1 = try {
    let _ = @src.build_source(
      doc.replace(old="Rule.where_", new="Nope.where_"),
      path="r.json.mbt",
      expected_name="r",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(bad1.contains("[J3009]"), content="true")
  // 恒等注记（键 == 字段名）→ J3009（无意义注记拒收，防手滑）
  let idoc =
    #|// jsonmbt: field-alias Rule.k = "k"
    #|struct Rule {
    #|  k : String
    #|}
    #|
    #|pub let r : Rule = Rule::{
    #|  k: "x",
    #|}
  let bad2 = try {
    let _ = @src.build_source(idoc, path="r.json.mbt", expected_name="r")
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(bad2.contains("[J3009]"), content="true")
  // 畸形注记行（语法不完整）→ J3009
  let mdoc =
    #|// jsonmbt: field-alias Rule.where_
    #|struct Rule {
    #|  where_ : String
    #|}
    #|
    #|pub let r : Rule = Rule::{
    #|  where_: "x",
    #|}
  let bad3 = try {
    let _ = @src.build_source(mdoc, path="r.json.mbt", expected_name="r")
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(bad3.contains("[J3009]"), content="true")
}

///|
test "import : Map 值类型命名改宿主键派生（#6-4）" {
  // 现状（issue 评论拍板采纳）：Map 值组名取首字段派生——cases 的值是
  // 4 字段 digest 条目却叫 Src_sha（误导）；改宿主键派生 cases → CasesEntry
  let json = "{\"cases\": {\"a.c\": {\"src_sha\": \"s1\", \"exit_code\": 0}, \"b.c\": {\"src_sha\": \"s2\", \"exit_code\": 1}}}"
  let out = do_import(json)
  inspect(out.contains("pub struct CasesEntry"), content="true")
  inspect(out.contains("Map[String, CasesEntry]"), content="true")
  inspect(out.contains("pub struct Src_sha"), content="false")
  // 往返：键序 = 源序（cases/a.c/b.c），值无损
  let built = @src.build_source(out, path="t.json.mbt")
  inspect(
    built,
    content="{\"cases\":{\"a.c\":{\"src_sha\":\"s1\",\"exit_code\":0},\"b.c\":{\"src_sha\":\"s2\",\"exit_code\":1}}}",
  )
}

///|
test "import : --type-name-map 语义命名（#6-4）" {
  // 机器派生名（Id/File2 等）零信息量——映射表给人起名的入口；
  // 键 = 派生名（用户从首次 import 产物里看到的），值 = 语义名
  let json = "{\"items\": [{\"id\": 1, \"file\": \"x\"}]}"
  let map : Map[String, String] = { "Id": "Entry" }
  let outcome = @src.import_source(
    json,
    path="t.json",
    stem="t",
    type_name_map=map,
  )
  inspect(outcome.content.contains("pub struct Entry"), content="true")
  inspect(outcome.content.contains("pub struct Id"), content="false")
  inspect(
    outcome.content.contains("Entry::{ id: 1, file: \"x\", }"),
    content="true",
  )
  // 命中的映射键不出现在 unmatched
  inspect(outcome.unmatched.length(), content="0")
  // 往返等价
  let built = @src.build_source(outcome.content, path="t.json.mbt")
  inspect(built, content="{\"items\":[{\"id\":1,\"file\":\"x\"}]}")
}

///|
test "import : --type-name-map 未命中键不阻断（hint 面，#6-4）" {
  let map : Map[String, String] = { "Id": "Entry", "Nope": "X" }
  let outcome = @src.import_source(
    "{\"items\": [{\"id\": 1, \"file\": \"x\"}]}",
    path="t.json",
    stem="t",
    type_name_map=map,
  )
  inspect(outcome.unmatched.length(), content="1")
  inspect(outcome.unmatched.contains("Nope"), content="true")
}

///|
test "import : --type-name-map 语义错拒绝（J1010，#6-4）" {
  // 值非法类型名（小写开头）
  let d1 = try {
    let _ = @src.import_source(
      "{\"items\": [{\"id\": 1}]}",
      path="t.json",
      stem="t",
      type_name_map={ "Id": "entry" },
    )
    "SUCCEEDED"
