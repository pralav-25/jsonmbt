///|
test "fill : 空容器按声明类型直填 + 头逐字节保留（#14-2b）" {
  let existing =
    #|struct Cfg {
    #|  list : Array[String]
    #|}
    #|
    #|pub let cfg : Cfg = Cfg::{ list: [], }
  // fill：源 JSON 与声明同步 → 产物 == 原文（值体重算结果相同）
  let filled1 = @src.fill_source(
    "{\"list\": []}",
    existing,
    path="cfg.json.mbt",
    stem="cfg",
  )
  // fill 产物以尾换行收束（生成器惯例）；值体与原文一致 = 同步态
  inspect(filled1, content=existing + "\n")
  // 源新增样本：值体按声明类型直吃（Array[String] 吃 "a"）——空容器
  // 声明类型即消歧（不再 Never）
  let filled2 = @src.fill_source(
    "{\"list\": [\"a\"]}",
    existing,
    path="cfg.json.mbt",
    stem="cfg",
  )
  inspect(filled2.contains("list: [\"a\"]"), content="true")
  inspect(
    @src.build_source(filled2, path="cfg.json.mbt", expected_name="cfg"),
    content="{\"list\":[\"a\"]}",
  )
}

///|
test "fill : 键集漂移按声明 enum 消歧（#14-2b）" {
  let existing =
    #|enum Case {
    #|  A(Ax)
    #|  B(Bx)
    #|}
    #|struct Ax {
    #|  a : Int
    #|}
    #|struct Bx {
    #|  b : Int
    #|}
    #|struct T {
    #|  xs : Array[Case]
    #|}
    #|
    #|pub let t : T = T::{ xs: [] }
  // 原始形态输入：按键集选变体
  let f1 = @src.fill_source(
    "{\"xs\": [{\"a\": 1}, {\"b\": 2}]}",
    existing,
    path="t.json.mbt",
    stem="t",
  )
  // #18 后数组元素单行尾逗号形（B 末元素无逗号）——消歧结果按新形态断言
  inspect(
    f1.contains("A(Ax::{ a: 1, }),") && f1.contains("B(Bx::{ b: 2, })]"),
    content="true",
  )
  inspect(
    @src.build_source(f1, path="t.json.mbt", expected_name="t"),
    content="{\"xs\":[{\"case\":\"A\",\"a\":1},{\"case\":\"B\",\"b\":2}]}",
  )
  // 降级产物形态输入（tag 对象）：case 键指示变体——fill 吃自己的产物
  let f2 = @src.fill_source(
    "{\"xs\": [{\"case\": \"A\", \"a\": 1}]}",
    existing,
    path="t.json.mbt",
    stem="t",
  )
  inspect(f2.contains("A(Ax::{ a: 1, })"), content="true")
}

///|
test "fill : 消歧失败 fail loud + 多余键拒（#14-2b）" {
  let existing =
    #|enum Case {
    #|  A(Ax)
    #|}
    #|struct Ax {
    #|  a : Int
    #|}
    #|struct T {
    #|  xs : Array[Case]
    #|}
    #|
    #|pub let t : T = T::{
    #|  xs: [],
    #|}
  // 键集无匹配变体
  let d1 = try {
    let _ = @src.fill_source(
      "{\"xs\": [{\"zz\": 1}]}",
      existing,
      path="t.json.mbt",
      stem="t",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d1.contains("[J3004]") && d1.contains("no variant"), content="true")
  // struct 键集多余
  let d2 = try {
    let _ = @src.fill_source(
      "{\"xs\": [], \"extra\": 1}",
      existing,
      path="t.json.mbt",
      stem="t",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d2.contains("[J3005]"), content="true")
}

///|
test "import : 含转义 JSON 往返无损（#16——真实世界的换行/引号/u 转义形态）" {
  // JSON 侧（RFC 8259）转义 → 解码值 → moonbit_escape 产 MoonBit 形态
  // → build 回吃（宽集）→ JSON 再生。字符串内容用 \u{} 形态构造
  // （moon 对字面量代理对语法发 deprecation 警告——内容不含警告面）
  let json = "{\"text\": \"a\\tb\\nc\\\"d\\\\e\\/f" +
    "\u{5c}u4e2d" +
    "\u{5c}ud83d\u{5c}ude80g\"}"
  let out = do_import(json)
  let built = @src.build_source(out, path="t.json.mbt")
  // 值语义等价（键序同、解码值同）
  let lhs = @src.json_parse(json, fname="a")
  let rhs = @src.json_parse(built, fname="b")
  inspect(@src.json_value_eq(lhs, rhs), content="true")
  // 输出规范形态：控制符/引号/反斜杠保 JSON 转义，非 ASCII 裸 UTF-8
  //（\u4e2d → 中、代理对 → 🚀——「无 \uXXXX 噪音」既定策略）
  inspect(built, content="{\"text\":\"a\\tb\\nc\\\"d\\\\e/f中🚀g\"}")
}

///|
test "import : 数组元素 null 提升 Option（#20）——契约要求产出合法 .json.mbt" {
  // 字段位 null 由 merge_samples 聚 Option；元素位曾直接调 lub 绕过聚合
  // → lub 的 `(JTNullLike, t) => t` 静默丢 null → 产物非法（J0002 generator bug）。
  // 三形态：null + 标量 / 全 null / null + 对象。
  let o1 = @src.import_source("{\"xs\": [null, 1, 2]}", path="t.json", stem="t")
  inspect(o1.content.contains("xs : Array[Int?]"), content="true")
  inspect(
    @src.build_source(o1.content, path="t.json.mbt"),
    content="{\"xs\":[null,1,2]}",
  )
  // 全 null 数组 → Array[Never?]（零信息 + 可空；Never 底型范式）
  let o2 = @src.import_source("[null, null]", path="t.json", stem="t")
  inspect(o2.content.contains("Array[Never?]"), content="true")
  inspect(
    @src.build_source(o2.content, path="t.json.mbt"),
    content="[null,null]",
  )
  // null + 对象元素：null 被吸收进 Option，对象仍定型
  let o3 = @src.import_source("[null, {\"a\": 1}]", path="t.json", stem="t")
  inspect(
    @src.build_source(o3.content, path="t.json.mbt"),
    content="[null,{\"a\":1}]",
  )
  // 对照（不得回退）：字段位多样本 null 仍是 Option（既有行为）
  let o4 = @src.import_source(
    "{\"items\": [{\"v\": null}, {\"v\": 1}]}",
    path="t.json",
    stem="t",
  )
  inspect(
    @src.build_source(o4.content, path="t.json.mbt"),
    content="{\"items\":[{\"v\":null},{\"v\":1}]}",
  )
}

///|
test "import : JSON 语法错报错码点用十六进制（#22 附带——十进制冒充 U+XXXX 误导定位）" {
  //   #22 落地后注：尾逗号在 jsonc 默认档已消解（json 档仍拒——P2-6① 迁移锚钉死）。
  // 本条只钉报错文案：旧实现 `U+\{c.to_int()}` 把**十进制**码点接在 U+ 后
  // （`]` = U+005D = 93 十进制 → 报成 "U+93"）。
  let d = try {
    let _ = @src.import_source("{\"a\": @}", path="t.json", stem="t")
    "ok"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { "non-diag" }
  }
  inspect(d.contains("U+0040"), content="true")
}


///|
test "审 P1-a : 多样本可选数组合流（lub 的 JTOption 臂）" {
  // {"a":[null,1]} x {"a":[null,2]}：#20 元素位自聚合后 JTOption 流入 lub，
  // 旧匹配表无 Option 臂落 hetero（Int? vs Int? 同型误拒）；Option 外壳
  // 合流 + 内层递归——同型/混型都归 Array[Int?]
  let out = do_import("[{\"a\":[null,1]},{\"a\":[null,2]}]")
  inspect(out.contains("a : Array[Int?]"), content="true")
  let out2 = do_import("[{\"a\":[1]},{\"a\":[null,2]}]")
  inspect(out2.contains("a : Array[Int?]"), content="true")
  // 真异构不合流（Option 臂不吞异型——内层递归仍走 hetero 拒）
  let d = try {
    let _ = do_import("[{\"a\":[1]},{\"a\":[\"x\"]}]")
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("[J4012]"), content="true")
}

///|
test "审 P1-c : fill 标量 payload 缺 value 键 fail loud（曾 [0] 越界 panic）" {
  // {"case":"Scalar"}（无 value 键）对声明 Scalar(Int)——数据与声明不同步
  // 曾在 render_variant_payload 取 payload_keys[0] panic 且绕过校验先行
  //（D-8 ①）；修后 J3006 指路
  let existing = "enum Payload {\n  Scalar(Int)\n  Obj(Meta)\n}\nstruct Meta {\n  k : Int\n}\npub let x : Payload = Scalar(1)\n"
  let d = try {
    let _ = @src.fill_source(
      "{\"case\":\"Scalar\"}",
      existing,
      path="x.json",
      fill_path="x.json.mbt",
      stem="x",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("[J3006]"), content="true")
  inspect(d.contains("no 'value' key"), content="true")
}

///|
test "#26 : 含换行字符串产 #| 多行——教师循环形态保真" {
  // 手写 #| → build 降级 → import/--fill 回写：emitter 对含 \n 的字符串
  // 产 #| 多行（值位括号包裹 + 无前导空格规范形），回写不再磨损成单行
  // 转义长串；单行值保持转义形态。产物 fmt 幂等（探针 2026-10-10：值位
  // 括号包裹 × fmt 归一缩进 × 二次 fmt 不动）
  // JSON 输入的 \n 转义用 \u{5c}n 构造（moon 源码层的双反斜杠歧义先例，
  // 见 D-9 三形态锚）；产物期望里的 \n 是真换行（moon \n 转义直书）
  let json_input = "{\"items\":[\"第一行\u{5c}n第二行\u{5c}n\",\"单行\"]}"
  let out = do_import(json_input)
  inspect(out.contains("(\n#|第一行\n#|第二行\n#|\n)"), content="true")
  inspect(out.contains("\"单行\""), content="true")
  // 回吃往返无损（#| 行净内容以 \n 连接——空行 = 裸标记）
  let built = @src.build_source(out, path="t.json.mbt", expected_name="t")
  inspect(built, content="{\"items\":[\"第一行\u{5c}n第二行\u{5c}n\",\"单行\"]}")
  // \r 不走多行（CRLF 源的行尾 \r 入值语义在读取层有歧面——转义保真）
  let cr = do_import("{\"k\":\"a\u{5c}r\u{5c}nb\"}")
  inspect(cr.contains("\"a\u{5c}r\u{5c}nb\""), content="true")
}

///|
test "#28 : is_legal_label 对齐 moon 词法区间表（表外字母不误收）" {
  // 表外（moon 拒、曾误判合法直出非法 label → J0002 generator bug）：
  // π(03C0)/α(03B1)/А(0400)/א(05D0)/अ(0905)/ก(0E01)/组合符(0301)/
  // NBSP(00A0 空隙)/全角空格(3000 空隙)/全角０(FF10)/℘(2118)——落 Map
  // 逃生门（is_sanitizable=false：π_ 也非法）
  let out = @src.import_source(
    "{\"locals\":{\"foo\":\"x\",\"π\":\"y\"}}",
    path="locals.tf.json",
    stem="locals",
  )
  inspect(out.content.contains("Map[String,"), content="true")
  // 表内（moon 收）：é(00E9)/°(00B0)/×(00D7)/µ(00B5)/Ā(0100)/ª(00AA)/
  // ⁰(2070)/中(4E2D)/あ(3042)/가(AC00)/𠀀(20000)/😀(1F600)——合法 label
  let zh = do_import("{\"中\":1}")
  inspect(zh.contains("中 : Int"), content="true")
  let emoji = do_import("{\"😀\":1}")
  inspect(emoji.contains("😀 : Int"), content="true")
  // ASCII 对照：数字开头键走既有 Map 逃生门（非 #28 变更面——回归确认）
  let d = do_import("{\"1abc\":1}")
  inspect(d.contains("Map[String,"), content="true")
}
